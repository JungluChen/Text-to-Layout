      "-c",
      "import json, math; from scipy.special import ellipk; from textlayout.research.formulas import cpw_z0; rows=[]\nfor w,g in [(10,6),(10,2),(10,30),(0.01,1000000)]:\n try:\n  actual,_=cpw_z0(w,g,11.9); k=w/(w+2*g); reference=30*math.pi/math.sqrt(6.45)*float(ellipk(1-k*k)/ellipk(k*k)); rows.append(dict(width=w,gap=g,actual=actual,reference=reference))\n except Exception as exc: rows.append(dict(width=w,gap=g,error=str(exc)))\nprint(json.dumps(rows,indent=2))"
