DEF ProbeResistor R 0 40 N N 1 L N
F0 "R" 0 70 50 H V C BNN
F1 "ProbeResistor" 0 -70 50 H V C TNN
F2 "probe:Resistor_PROBERESISTOR" 0 0 0 H I C CNN
